{
  "name": "sensoria-attendance",
  "version": "1.0.0",
  "description": "Simple web-based check-in / check-out system for part-time and gig workers, with supervisor approval and monthly CSV export.",
  "private": true,
  "main": "src/cloudflare.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:restaurant": "wrangler dev --config wrangler.restaurant.jsonc",
    "deploy:restaurant": "wrangler deploy --config wrangler.restaurant.jsonc",
    "start": "node --disable-warning=ExperimentalWarning src/node.js",
    "start:dev": "node --disable-warning=ExperimentalWarning --watch src/node.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "guides": "node docs/build-guides.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "docx": "^9.8.1",
    "wrangler": "^4.147.0"
  }
}
