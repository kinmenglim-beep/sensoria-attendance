{
  // Second deployment of the same app for Ossu (the restaurant): its own Worker, link and database.
  // Deploy with: npx wrangler deploy --config wrangler.ossu.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ossu-attendance",
  "main": "src/cloudflare.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  // A separate database, so the restaurant's staff and hours never mix with the other venue's.
  "d1_databases": [
    { "binding": "DB", "database_name": "ossu-attendance" }
  ],
  "vars": {
    // Name shown in the menu bar and browser tab.
    "APP_NAME": "Ossu Attendance",
    "APP_TZ": "Asia/Kuala_Lumpur",
    // Attendance record, not payroll: show the real clock times, unrounded.
    "ROUND_MINUTES": "0"
  },
  "observability": { "enabled": true }
}
